# Copy to .env for local overrides. Everything prefixed VITE_ is baked into the public JavaScript
# bundle, so never put secrets here.

# Base URL of the API. Leave as /api both locally (Vite proxies it to http://localhost:5001) and on
# Vercel (the site and API share one domain). Only change it if the API is hosted somewhere else.
VITE_API_URL=/api
