# Copy to .env for local development:  cp .env.example .env
# In production (Vercel), set these in Project -> Settings -> Environment Variables instead.
# Never commit a real .env file.

# --- Server ---
PORT=5001
# "production" turns on strict startup checks (https CLIENT_URL, strong JWT_SECRET, MONGODB_URI required).
# On Vercel these checks are always on.
NODE_ENV=development
# Site URL: used for CORS and for links in reminder emails. No trailing slash.
# On Vercel you can leave it unset: it defaults to your production domain.
CLIENT_URL=http://localhost:5173

# --- Database ---
# Local:      mongodb://127.0.0.1:27017/jobtracker
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jobtracker?retryWrites=true&w=majority
# Uploaded resumes are stored in this database too (GridFS), so no separate file storage is needed.
MONGODB_URI=mongodb://127.0.0.1:27017/jobtracker

# --- Auth ---
# Signs login tokens. Must be long and random in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Invite code required to create an account. Leave empty to let anyone sign up.
# Recommended for a hosted site you only share with friends.
REGISTRATION_CODE=

# --- Uploads ---
# Default 10 locally. On Vercel it's capped at 4 (Vercel limits request bodies to 4.5 MB).
MAX_UPLOAD_MB=10

# --- Email notifications (optional) ---
# Leave SMTP_HOST empty to disable real sending; emails are then logged to the console.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=you@gmail.com,
#        SMTP_PASS=<a Google "app password", not your normal password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Job Tracker <no-reply@jobtracker.local>"
# Local server: how often (minutes) the reminder notifier runs. 0 disables it.
REMINDER_CHECK_INTERVAL_MIN=60
# Time zone for reminder times in emails (users' own browser time zone is used once they save Settings).
DEFAULT_TIME_ZONE=Asia/Kolkata
# Vercel: the reminder job runs once a day via Vercel Cron (see vercel.json) and needs this secret.
# Generate it like JWT_SECRET. Without it the job is disabled.
CRON_SECRET=

# --- Advanced ---
# Number of proxies in front of the API. Defaults to 1 in production (correct for Vercel), 0 otherwise.
# TRUST_PROXY=1
